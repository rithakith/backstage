# WSO2 API Manager Credentials
WSO2_CLIENT_ID=your_client_id_here
WSO2_CLIENT_SECRET=your_client_secret_here

# WSO2 Platform Gateway
WSO2_GATEWAY_DISCOVERY_USERNAME=admin
WSO2_GATEWAY_DISCOVERY_PASSWORD=admin

# Catalog Providers
WSO2_APIM_USERNAME=admin
WSO2_APIM_PASSWORD=admin

# Auth Providers
ASGARDEO_CLIENT_ID=your_asgardeo_client_id
ASGARDEO_CLIENT_SECRET=your_asgardeo_client_secret

# Backstage Session
BACKSTAGE_SESSION_SECRET=at_least_32_characters_long_random_string

# Sync Schedules
ASGARDEO_SYNC_FREQUENCY_MINUTES=30
ASGARDEO_SYNC_TIMEOUT_MINUTES=5
ASGARDEO_SYNC_INITIAL_DELAY_SECONDS=5
ASGARDEO_RETRIES=2
